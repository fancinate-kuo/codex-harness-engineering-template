{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Approval Decision",
  "type": "object",
  "required": [
    "taskId",
    "decision",
    "requestedAt"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "requestedAt": {
      "type": "string"
    },
    "decidedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "decidedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
