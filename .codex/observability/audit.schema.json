{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Audit Event",
  "type": "object",
  "required": [
    "timestamp",
    "taskId",
    "actor",
    "action"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "before": {
      "type": [
        "object",
        "null"
      ]
    },
    "after": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
