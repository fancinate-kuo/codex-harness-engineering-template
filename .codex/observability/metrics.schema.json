{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Metric Event",
  "type": "object",
  "required": [
    "timestamp",
    "taskId",
    "type"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "durationMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
