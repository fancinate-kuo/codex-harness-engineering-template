{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "state",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "requirementId": {
      "type": [
        "string",
        "null"
      ]
    },
    "featureId": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "assignedAgent": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
