{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiled Harness Workflow",
  "type": "object",
  "required": ["version", "name", "taskId", "poolSource", "nodes"],
  "properties": {
    "version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "poolSource": { "const": "agent-pool.json" },
    "signals": { "type": "object" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "mutable", "worktreeRequired", "dependsOn", "produces", "retryable", "maxRetries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "agent": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "mutable": { "type": "boolean" },
          "worktreeRequired": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "allowSkippedDependencies": { "type": "boolean" },
          "allowedSkippedDependencies": { "type": "array", "items": { "type": "string" } },
          "produces": { "type": "array", "items": { "type": "string" } },
          "retryable": { "type": "boolean" },
          "maxRetries": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
