{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Experiment",
  "type": "object",
  "required": [
    "id",
    "variants",
    "benchmarks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "config"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
