{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Graph Query Contract",
  "type": "object",
  "required": [
    "kind",
    "target"
  ],
  "properties": {
    "kind": {
      "enum": [
        "context",
        "impact",
        "changes",
        "search",
        "security",
        "semantic"
      ]
    },
    "target": {
      "type": "string"
    },
    "provider": {
      "enum": [
        "auto",
        "gitnexus",
        "scip",
        "joern"
      ],
      "default": "auto"
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "reason": {
      "type": "string"
    }
  }
}
