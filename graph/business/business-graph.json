{
  "version": 1,
  "requirements": [
    {
      "id": "REQ-FORUM-001",
      "title": "Authors can edit their own replies",
      "features": [
        "forum.reply.edit"
      ]
    },
    {
      "id": "REQ-SORA-001",
      "title": "Readers can discover and read published Sora articles",
      "features": [
        "sora.article.browse"
      ]
    },
    {
      "id": "REQ-PLATFORM-001",
      "title": "Operators can run the Control Plane with verified production readiness",
      "features": [
        "platform.production-readiness"
      ]
    }
  ],
  "features": [
    {
      "id": "forum.reply.edit",
      "title": "Edit forum reply",
      "capability": "forum.reply-management",
      "module": "forum",
      "apis": [
        "PATCH /replies/:id"
      ],
      "tables": [
        "forum_replies"
      ],
      "tests": [
        "tests/integration/forum/reply-edit",
        "tests/e2e/forum/reply-edit"
      ],
      "adrs": [],
      "owners": [
        "forum-team"
      ],
      "risk": "medium"
    },
    {
      "id": "sora.article.browse",
      "title": "Browse Sora articles",
      "capability": "sora.content-discovery",
      "module": "forum",
      "apis": [
        "GET /forum/articles",
        "GET /forum/articles/:slug"
      ],
      "tables": [],
      "tests": [
        "tests/integration/forum/article-browsing",
        "tests/e2e/forum/article-browsing"
      ],
      "adrs": [],
      "owners": [
        "sora-team"
      ],
      "risk": "medium"
    },
    {
      "id": "platform.production-readiness",
      "title": "Verify Control Plane production readiness",
      "capability": "platform.runtime-readiness",
      "module": "platform",
      "apis": [
        "GET /health",
        "GET /ready"
      ],
      "tables": [],
      "tests": [
        "tests/unit/production-readiness",
        "tests/integration/control-plane-readiness",
        "tests/integration/postgres-readiness"
      ],
      "adrs": [],
      "owners": [
        "platform-team"
      ],
      "risk": "high"
    }
  ],
  "capabilities": [
    {
      "id": "forum.reply-management",
      "title": "Forum reply management",
      "modules": [
        "forum"
      ]
    },
    {
      "id": "sora.content-discovery",
      "title": "Sora content discovery",
      "modules": [
        "forum"
      ]
    },
    {
      "id": "platform.runtime-readiness",
      "title": "Control Plane runtime readiness",
      "modules": [
        "platform"
      ]
    }
  ],
  "modules": [
    {
      "id": "forum",
      "backend": "apps/api/src/modules/forum",
      "frontend": "apps/web/src/features/forum",
      "domain": "packages/domain/src/forum",
      "contracts": "packages/contracts/src/forum"
    },
    {
      "id": "reference",
      "application": "packages/reference/src/application",
      "domain": "packages/reference/src/domain",
      "contracts": "packages/reference/src/contracts",
      "infrastructure": "packages/reference/src/infrastructure"
    },
    {
      "id": "platform",
      "controlPlane": "scripts/control-plane",
      "persistence": "scripts/persistence"
    }
  ],
  "apis": [
    {
      "id": "PATCH /replies/:id",
      "feature": "forum.reply.edit"
    },
    {
      "id": "GET /forum/articles",
      "feature": "sora.article.browse"
    },
    {
      "id": "GET /forum/articles/:slug",
      "feature": "sora.article.browse"
    },
    {
      "id": "GET /health",
      "feature": "platform.production-readiness"
    },
    {
      "id": "GET /ready",
      "feature": "platform.production-readiness"
    }
  ],
  "tables": [
    {
      "id": "forum_replies",
      "ownerModule": "forum"
    }
  ],
  "tests": [
    {
      "id": "tests/integration/forum/reply-edit",
      "verifies": [
        "forum.reply.edit"
      ]
    },
    {
      "id": "tests/integration/forum/article-browsing",
      "verifies": [
        "sora.article.browse"
      ]
    },
    {
      "id": "tests/e2e/forum/article-browsing",
      "verifies": [
        "sora.article.browse"
      ]
    },
    {
      "id": "tests/e2e/forum/reply-edit",
      "verifies": [
        "forum.reply.edit"
      ]
    },
    {
      "id": "tests/unit/production-readiness",
      "verifies": [
        "platform.production-readiness"
      ]
    },
    {
      "id": "tests/integration/control-plane-readiness",
      "verifies": [
        "platform.production-readiness"
      ]
    },
    {
      "id": "tests/integration/postgres-readiness",
      "verifies": [
        "platform.production-readiness"
      ]
    }
  ],
  "adrs": []
}
